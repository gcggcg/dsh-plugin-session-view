{
  "name": "dsh-plugin-session-view",
  "version": "1.0.1",
  "private": true,
  "description": "Session plugin, MCP server and skill panel for the DeepSeek Harness Web conversation view.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "scripts": {
    "smoke": "node smoke.mjs",
    "prepare": "node publish/prepare.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
